{
    "name": "laz/preuvia-laravel",
    "description": "Laravel SDK for the Preuvia API v1: dossiers, proof documents, Datasure certifications and signed callbacks.",
    "type": "library",
    "keywords": ["laravel", "preuvia", "sdk", "api", "certification", "webhook"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Preuvia\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Preuvia\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Preuvia\\Laravel\\PreuviaServiceProvider"
            ],
            "aliases": {
                "Preuvia": "Preuvia\\Laravel\\Facades\\Preuvia"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
